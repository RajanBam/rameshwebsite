---
import BaseLayout from './BaseLayout.astro';
import type { Tool } from '../lib/registry';

export interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const { content } = tool;

// Structured data: the tool itself + FAQ (both help rich results / AI search).
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any (web browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: tool.seo.description,
};
const faqLd = content && content.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: content.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const jsonLd = faqLd ? [appLd, faqLd] : [appLd];
---

<BaseLayout
  title={tool.seo.title}
  description={tool.seo.description}
  keywords={tool.seo.keywords}
  image={`/thumbnails/${tool.slug}.svg`}
  jsonLd={jsonLd}
>
  <article class="tool-page">
    <!-- Above the fold: clean and quiet, Apple voice. -->
    <header class="tool-head container">
      <h1>{tool.name}</h1>
      <p class="tool-tagline">{tool.tagline}</p>
    </header>

    <!-- The tool itself (interactive island). -->
    <section class={`tool-stage container ${tool.wide ? 'tool-stage-wide' : ''}`}>
      <slot />
    </section>

    <!-- Ad slot: ALWAYS below the tool/result, never above. Empty until
         AdSense is integrated (months 2–3). Reserved to avoid layout shift. -->
    <div class="ad-slot container" aria-hidden="true"></div>

    <!-- Below the fold: the SEO + AdSense content layer. -->
    {content && (
      <div class="tool-content container">
        <p class="lead">{content.intro}</p>

        <section class="how">
          <h2>How it works</h2>
          <ol>
            {content.steps.map((s) => <li>{s}</li>)}
          </ol>
        </section>

        {content.faq.length > 0 && (
          <section class="faq">
            <h2>Frequently asked questions</h2>
            <dl>
              {content.faq.map((f) => (
                <div class="faq-item">
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .tool-page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
    background:
      radial-gradient(620px 300px at 80% -5%, rgba(0, 102, 204, 0.06), transparent 70%),
      radial-gradient(520px 280px at 5% 5%, rgba(0, 138, 92, 0.05), transparent 70%);
  }
  .tool-head { text-align: center; max-width: 720px; }
  .tool-head h1 {
    font-size: var(--t-title);
    background: linear-gradient(92deg, var(--ink), var(--blue));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .tool-tagline {
    margin-top: 0.75rem;
    color: var(--dim);
    font-size: var(--t-sub);
  }
  .tool-stage {
    margin-top: clamp(2rem, 5vw, 3rem);
    max-width: 860px;
  }
  .tool-stage-wide { max-width: 1040px; }
  .ad-slot { max-width: 860px; min-height: 0; }
  .tool-content {
    max-width: 720px;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  .lead { font-size: var(--t-sub); color: var(--ink); }
  .tool-content h2 {
    font-size: var(--t-title);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .how ol { padding-left: 1.25rem; color: var(--ink); }
  .how li { margin-bottom: 0.75rem; }
  .faq-item {
    padding-block: 1.25rem;
    border-top: 1px solid var(--hairline);
  }
  .faq-item dt { font-weight: 600; margin-bottom: 0.4rem; }
  .faq-item dd { margin: 0; color: var(--dim); }
</style>
