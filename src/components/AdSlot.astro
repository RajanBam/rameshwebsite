---
// A single AdSense display unit. Renders nothing unless BOTH a publisher ID
// (SITE.adsense) and this unit's slot ID are configured, so the reserved
// space stays empty and clean until ads are switched on. Always placed
// BELOW the tool and its result, never above.
import { SITE } from '../lib/site';

export interface Props {
  /** AdSense ad-unit (slot) ID. */
  slot: string;
  /** Extra classes for the wrapper. */
  class?: string;
}
const { slot, class: className = '' } = Astro.props;
const active = !!SITE.adsense && !!slot;
---

{active && (
  <aside class={`ad-unit ${className}`} aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={SITE.adsense}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  .ad-unit {
    display: block;
    margin-inline: auto;
    text-align: center;
  }
  .ad-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.4rem;
  }
</style>
